@page "/auth/confirm-email"
@using LinkShopHub.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<AppUser> UserManager
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h4">Email Confirmation</MudText>

@if (Succeeded)
{
    <MudAlert Severity="Severity.Success">Your email has been confirmed. You can now log in.</MudAlert>
    <MudButton Href="/auth/login" Variant="Variant.Filled" Color="Color.Primary">Go to Login</MudButton>
}
else
{
    <MudAlert Severity="Severity.Error">Invalid or expired confirmation link.</MudAlert>
}

@code
{
    private bool Succeeded = false;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("userId", out var userIdString) &&
            QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var token))
        {
            var user = await UserManager.FindByIdAsync(userIdString);
            if (user != null)
            {
                var result = await UserManager.ConfirmEmailAsync(user, token);
                Succeeded = result.Succeeded;
            }
        }
    }
}