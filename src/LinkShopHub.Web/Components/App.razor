@using Microsoft.AspNetCore.Components.Authorization
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["LinkShopHub.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>  <!-- Neu: Global Auth-State (Cookie-User) für alle Routes/Komponenten -->
        <Routes @rendermode="InteractiveServer" />  <!-- Dein Original: InteractiveServer-Mode bleibt -->
    </CascadingAuthenticationState>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="https://js.stripe.com/v3/"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="/interops.js"></script>
</body>

</html>